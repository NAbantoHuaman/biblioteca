						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
						"method": "PUT",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/prestamos/devolver/1", "host": ["{{baseUrl}}"], "path": ["api", "prestamos", "devolver", "1"] }
					}
				},
				{
					"name": "Todos los Préstamos (ADMIN)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/prestamos/todos", "host": ["{{baseUrl}}"], "path": ["api", "prestamos", "todos"] }
					}
				},
				{
					"name": "Listar Vencidos (ADMIN)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/prestamos/vencidos", "host": ["{{baseUrl}}"], "path": ["api", "prestamos", "vencidos"] }
					}
				}
			]
		},
		{
			"name": "4. Usuarios",
			"item": [
				{
					"name": "Ver Mi Perfil",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/usuarios/perfil", "host": ["{{baseUrl}}"], "path": ["api", "usuarios", "perfil"] }
					}
				},
				{
					"name": "Listar Usuarios (ADMIN)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "usuarios"] }
					}
				},
				{
					"name": "Obtener por ID (ADMIN)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
						"method": "GET",
						"header": [],
