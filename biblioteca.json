{
	"info": {
		"_postman_id": "biblioteca-api-full-v2",
		"name": "Biblioteca API - Gestión Completa",
		"description": "Colección definitiva con el 100% de los endpoints del backend implementados.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Autenticación (Público)",
			"item": [
				{
					"name": "Registro de Usuario",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Pérez\",\n  \"email\": \"viva.idat@example.com\",\n  \"password\": \"password123\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
					}
				},
				{
					"name": "Login (Auto-guarda Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.accessToken) {",
									"    pm.collectionVariables.set(\"accessToken\", jsonData.data.accessToken);",
									"    console.log('✅ Token guardado automáticamente');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@biblioteca.edu.pe\",\n  \"password\": \"130404\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
					}
				},
				{
					"name": "Renovar Token (Refresh)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"pega_aqui_el_refresh_token\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh"] }
					}
				},
				{
					"name": "Logout",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
						"method": "POST",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
					}
				}
			]
		},
		{
			"name": "2. Libros",
			"item": [
				{
					"name": "Listar Todos",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/libros", "host": ["{{baseUrl}}"], "path": ["api", "libros"] }
					}
				},
				{
					"name": "Obtener por ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/libros/1", "host": ["{{baseUrl}}"], "path": ["api", "libros", "1"] }
					}
				},
				{
					"name": "Buscar (Título/Autor)",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/libros/buscar?termino=Quijote", "host": ["{{baseUrl}}"], "path": ["api", "libros", "buscar"], "query": [{ "key": "termino", "value": "Quijote" }] }
					}
				},
				{
					"name": "Libros Disponibles",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/libros/disponibles", "host": ["{{baseUrl}}"], "path": ["api", "libros", "disponibles"] }
					}
				},
				{
					"name": "Buscar por Género",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/libros/genero/Clásico", "host": ["{{baseUrl}}"], "path": ["api", "libros", "genero", "Clásico"] }
					}
				},
				{
					"name": "Crear Libro (ADMIN)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"titulo\": \"El Quijote\",\n  \"autor\": \"Miguel de Cervantes\",\n  \"isbn\": \"1234567890\",\n  \"editorial\": \"Editorial Idat\",\n  \"anioPublicacion\": 1605,\n  \"genero\": \"Clásico\",\n  \"stock\": 10\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/api/libros", "host": ["{{baseUrl}}"], "path": ["api", "libros"] }
					}
				},
				{
					"name": "Actualizar Libro (ADMIN)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
						"method": "PUT",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"titulo\": \"El Quijote - Edición Especial\",\n  \"autor\": \"Miguel de Cervantes\",\n  \"isbn\": \"1234567890\",\n  \"editorial\": \"Editorial Idat\",\n  \"anioPublicacion\": 2024,\n  \"genero\": \"Clásico\",\n  \"stock\": 15\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/api/libros/1", "host": ["{{baseUrl}}"], "path": ["api", "libros", "1"] }
					}
				},
				{
					"name": "Eliminar Libro (ADMIN)",
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
						"method": "DELETE",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/libros/1", "host": ["{{baseUrl}}"], "path": ["api", "libros", "1"] }
					}
				}
			]
		},
		{
			"name": "3. Préstamos",
			"item": [
				{
					"name": "Mi historial de préstamos",
