						"header": [],
						"url": { "raw": "{{baseUrl}}/api/prestamos/mis-prestamos", "host": ["{{baseUrl}}"], "path": ["api", "prestamos", "mis-prestamos"] }
					}
				},
				{
					"name": "Nuevo Préstamo (ADMIN)",
